# =============================================================
# account-books 환경변수 목록
# 이 파일은 커밋됩니다 — 실제 값은 절대 여기에 쓰지 말 것.
#
# 로컬 개발: apps/main/web/.env.local 에 실제 값 입력
# CI:        GitHub Secrets (Settings > Secrets and variables > Actions)
# 배포:      Vercel 프로젝트 환경변수 설정
# =============================================================

# ── Supabase (브라우저 노출 가능) ───────────────────────────
# Supabase 프로젝트 > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase 프로젝트 > Settings > API > anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (서버/Edge Function 전용 — 절대 클라이언트 코드 금지) ──
# Supabase 프로젝트 > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase 계정 > Account > Access Tokens
SUPABASE_ACCESS_TOKEN=your-access-token

# Supabase 프로젝트 > Settings > General > Reference ID
SUPABASE_PROJECT_ID=your-project-ref

# Supabase 프로젝트 생성 시 설정한 DB 비밀번호
SUPABASE_DB_PASSWORD=your-db-password

# ── Auth / SMTP (서버 전용 — 클라이언트 코드 금지) ─────────────────
# 프로덕션 이메일 발송용 SMTP (로컬은 Inbucket이 처리하므로 불필요)
# config.toml [auth.email.smtp] 섹션 활성화 시 함께 사용
SUPABASE_AUTH_SMTP_HOST=smtp.sendgrid.net
SUPABASE_AUTH_SMTP_PORT=587
SUPABASE_AUTH_SMTP_USER=apikey
SUPABASE_AUTH_SMTP_PASS=your-smtp-api-key
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=noreply@paylens.app

# ── Site URL (Auth 리다이렉트 기준 URL) ──────────────────────────────
# 로컬: http://127.0.0.1:3000 / 프로덕션: https://paylens.app (또는 Vercel 도메인)
SITE_URL=http://127.0.0.1:3000

# ── Upstash Redis (S-3-5, 통계 캐시 레이어 — 서버 전용) ────────────────
# Upstash 콘솔 > Redis > 해당 DB > REST API 섹션에서 확인
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# ── 운영자 화이트리스트 (F-3-1-5, 동의어 사전 관리 등 — 서버 전용) ──────
# 운영자로 취급할 로그인 이메일, 쉼표로 구분. NEXT_PUBLIC_ 접두사 금지(클라이언트 노출 방지).
ADMIN_EMAILS=you@example.com

# ── Google Sheets 연동 (scripts/sync-test-sheet.mjs 전용 — 앱 코드 미사용) ──
# 설정 방법: docs/GOOGLE_SHEETS_SETUP.md 참고
# 서비스 계정 JSON 키 파일 경로 (기본값: scripts/.service-account.json)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=../../scripts/.service-account.json
# 시트를 저장할 Google Drive 폴더 ID (Drive URL에서 마지막 부분 복사)
GOOGLE_DRIVE_FOLDER_ID=1q2Bo3GRTH6vnLsV2KRlxeQoKZbfhFf6X
# 수동 생성한 Google Sheets ID (URL: /spreadsheets/d/{ID}/edit)
GOOGLE_SPREADSHEET_ID=1pZiuVutwu19BbK8U83A3K2Us7CtF8Brah_Yiydoj9YE
